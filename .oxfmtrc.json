{
  // MIRRORED PAIR with @jlg/oxfmt's oxfmtrc.json. oxfmt has no `extends`
  // (verified 2026-07-20, oxfmt 0.59), so the shared base cannot compose into
  // this root config the way @jlg/oxlint does — `printWidth` and
  // `sortPackageJson` are copied from @jgeschwendt/oxfmt@0.1.0 by necessity and
  // must be kept in sync with it. The other keys are this repo's local settings.
  // public/background: wasm-bindgen output, regenerated by `bun run
  // background:build` — never hand-format it.
  "ignorePatterns": [".vscode/**", "public/background/**"],
  // From @jlg/oxfmt: Prettier-era default (oxfmt's own default is 100).
  "printWidth": 80,
  "singleQuote": true,
  // From @jlg/oxfmt: oxfmt does not read package.json's "prettier" field, so the
  // default (on) would reorder every package.json.
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/app/global.css"
  }
}
