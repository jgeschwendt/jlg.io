{
  "name": "jlg.io",
  "version": "0.0.0",
  "description": "web profile application",
  "author": "joshua@geschwendt.com",
  "license": "UNLICENSED",
  "repository": "git@github.com:jgeschwendt/jlg.io.git",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "@vercel/speed-insights",
      "esbuild",
      "sharp"
    ]
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "singleQuote": true,
    "tailwindStylesheet": "./src/app/global.css"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "7.0.1",
    "@fortawesome/free-solid-svg-icons": "7.0.1",
    "@vercel/analytics": "1.5.0",
    "@vercel/speed-insights": "1.2.0",
    "geist": "1.4.2",
    "http-status-codes": "2.3.0",
    "motion": "12.15.0",
    "next": "15.5.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "serialize-error": "12.0.0",
    "sharp": "0.34.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.34.0",
    "@jlg/eslint": "github:jgeschwendt/jlg#next&path:packages/eslint",
    "@jlg/tsconfig": "github:jgeschwendt/jlg#next&path:packages/tsconfig",
    "@next/eslint-plugin-next": "15.5.2",
    "@tailwindcss/postcss": "4.1.12",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.34.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-unicorn": "60.0.0",
    "globals": "16.3.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vercel": "47.0.4"
  },
  "scripts": {
    "build": "next build",
    "cspell": "pnpm dlx cspell **/*.{md,mjs,ts,tsx}",
    "dev": "next dev --turbopack",
    "favicon": "pnpm dlx svg-to-ico public/jg.svg src/app/favicon.ico",
    "lint": "eslint .",
    "ncu": "pnpm dlx npm-check-updates -u && pnpm up && pnpm install",
    "start": "next start"
  }
}
