{
  "name": "jlg.io",
  "version": "0.1.0",
  "description": "web profile app",
  "license": "UNLICENSED",
  "author": "joshua@geschwendt.com",
  "repository": "git@github.com:jgeschwendt/jlg.io.git",
  "type": "module",
  "scripts": {
    "background:build": "bun scripts/background-wasm.ts",
    "build": "bun --bun next build",
    "coverage": "rm -rf .nyc_output coverage && bun run coverage:build && cargo run --manifest-path e2e/Cargo.toml --bin e2e -- --mode prod && bun run coverage:report",
    "coverage:build": "COVERAGE=1 bun --bun next build",
    "coverage:dev": "rm -rf .nyc_output coverage && cargo run --manifest-path e2e/Cargo.toml --bin e2e && bun run coverage:report",
    "coverage:report": "bun scripts/coverage-report.ts",
    "cspell": "bunx cspell '**/*.{md,mjs,ts,tsx}'",
    "dev": "bun --bun next dev",
    "e2e:remote": "cargo run --manifest-path e2e/Cargo.toml --bin e2e -- --base",
    "favicon": "bunx svg-to-ico public/jg.svg src/app/favicon.ico",
    "fmt": "bun --bun oxfmt",
    "fmt:check": "bun --bun oxfmt --check",
    "lint": "bun --bun oxlint --report-unused-disable-directives",
    "resume:pdf": "bun run build && cargo run --manifest-path e2e/Cargo.toml --bin resume-pdf",
    "start": "bun --bun next start",
    "update": "bunx npm-check-updates -u && bun install"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "geist": "1.7.2",
    "http-status-codes": "2.3.0",
    "motion": "13.4.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@jlg/oxfmt": "0.1.0",
    "@jlg/oxlint": "0.1.0",
    "@jlg/tsconfig": "0.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/istanbul-lib-report": "3.0.3",
    "@types/istanbul-reports": "3.0.4",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "lefthook": "2.1.14",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "postcss": "8.5.28",
    "swc-plugin-coverage-instrument": "0.0.32",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vercel": "59.25.0"
  },
  "engines": {
    "node": "24.x"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "@vercel/speed-insights",
    "esbuild",
    "lefthook",
    "oxfmt",
    "sharp"
  ]
}
