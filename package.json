{
  "name": "jlg.io",
  "version": "0.0.0",
  "description": "web profile application",
  "author": "joshua@geschwendt.com",
  "license": "UNLICENSED",
  "repository": "git@github.com:jgeschwendt/jlg.io.git",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "@vercel/speed-insights",
      "esbuild",
      "sharp"
    ]
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "singleQuote": true,
    "tailwindStylesheet": "./src/app/global.css"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "7.1.0",
    "@fortawesome/free-solid-svg-icons": "7.1.0",
    "@vercel/analytics": "1.6.1",
    "@vercel/speed-insights": "1.3.1",
    "geist": "1.5.1",
    "http-status-codes": "2.3.0",
    "motion": "12.29.0",
    "next": "16.1.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "serialize-error": "13.0.1",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@jlg/eslint": "npm:@jgeschwendt/eslint@0.0.0-canary.0",
    "@jlg/tsconfig": "npm:@jgeschwendt/tsconfig@0.0.0-canary.0",
    "@next/eslint-plugin-next": "16.1.4",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "25.0.10",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-unicorn": "62.0.0",
    "globals": "17.0.0",
    "postcss": "8.5.6",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "vercel": "50.4.9"
  },
  "scripts": {
    "build": "next build",
    "cspell": "pnpm dlx cspell **/*.{md,mjs,ts,tsx}",
    "dev": "next dev --turbopack",
    "favicon": "pnpm dlx svg-to-ico public/jg.svg src/app/favicon.ico",
    "lint": "eslint .",
    "ncu": "pnpm dlx npm-check-updates -u && pnpm up && pnpm install",
    "start": "next start"
  }
}
