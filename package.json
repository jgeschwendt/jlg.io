{
  "name": "jlg.io",
  "version": "0.1.0",
  "description": "web profile app",
  "license": "UNLICENSED",
  "author": "joshua@geschwendt.com",
  "repository": "git@github.com:jgeschwendt/jlg.io.git",
  "type": "module",
  "scripts": {
    "background:build": "bun scripts/background-wasm.ts",
    "build": "bun --bun next build",
    "cspell": "bunx cspell '**/*.{md,mjs,ts,tsx}'",
    "dev": "bun --bun next dev",
    "favicon": "bunx svg-to-ico public/jg.svg src/app/favicon.ico",
    "lint": "oxlint --report-unused-disable-directives",
    "resume:pdf": "bun run build && bun scripts/resume-pdf.ts",
    "start": "bun --bun next start",
    "update": "bunx npm-check-updates -u && bun install"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "7.3.0",
    "@fortawesome/free-solid-svg-icons": "7.3.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "geist": "1.7.2",
    "http-status-codes": "2.3.0",
    "motion": "12.42.2",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@jlg/oxfmt": "npm:@jgeschwendt/oxfmt@0.1.0",
    "@jlg/oxlint": "npm:@jgeschwendt/oxlint@0.1.0",
    "@jlg/tsconfig": "npm:@jgeschwendt/tsconfig@0.1.0",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.25.0",
    "playwright": "^1.61.1",
    "postcss": "8.5.16",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vercel": "54.20.1"
  },
  "engines": {
    "node": "24.x"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "@vercel/speed-insights",
    "esbuild",
    "lefthook",
    "oxfmt",
    "sharp"
  ]
}
